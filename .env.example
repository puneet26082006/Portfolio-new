# Browser-safe project settings only. Never use a Supabase secret/service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Formspree form ID (the final segment of https://formspree.io/f/xxxxxxxx).
NEXT_PUBLIC_FORMSPREE_FORM_ID=

# Optional: your https://cal.com/... or https://calendly.com/... booking link.
NEXT_PUBLIC_BOOKING_URL=

# Google/GitHub OAuth secrets belong in Supabase > Authentication > Providers.
# They are NOT required by this Next.js application and must never be NEXT_PUBLIC_.

# Canonical public origin. Set to the final HTTPS domain before the production build.
SITE_URL=

# Optional public ownership-verification codes (not account passwords or API secrets).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
